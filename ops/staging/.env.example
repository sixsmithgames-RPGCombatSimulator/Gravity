# Local production-like staging rehearsal. Copy to a non-committed env file or
# export these through your shell/secret manager before using the staging compose file.
STAGING_POSTGRES_USER=gravity
STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-password
STAGING_POSTGRES_DB=gravity_staging
STAGING_POSTGRES_PORT=55432

STAGING_REDIS_PASSWORD=replace-with-a-different-long-random-password
STAGING_REDIS_PORT=56379

STAGING_API_PORT=3110
STAGING_API_ORIGIN=http://127.0.0.1:3110
STAGING_WEB_PORT=4197
STAGING_WEB_ORIGIN=http://127.0.0.1:4197

STAGING_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
STAGING_CLERK_ISSUER=https://your-staging-clerk-domain.example.com
STAGING_CLERK_AUDIENCE=
STAGING_JOIN_CODE_PEPPER=replace-with-at-least-32-random-characters

STAGING_RATE_LIMIT_WINDOW_MS=900000
STAGING_RATE_LIMIT_MAX_REQUESTS=100
