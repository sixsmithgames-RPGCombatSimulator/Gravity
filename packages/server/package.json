{
  "name": "@gravity/server",
  "version": "0.1.0",
  "description": "Gravity backend server - Node.js API and game services",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run src/sessions/postgresSessionRepository.integration.test.ts",
    "e2e:server": "tsx e2e/server.ts",
    "e2e:staging-server": "tsx e2e/stagingServer.ts",
    "lint": "eslint src --ext ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gravity/core": "*",
    "express": "^4.18.0",
    "socket.io": "^4.6.0",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "^3.4.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",
    "zod": "^3.22.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "dotenv": "^16.3.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.10.0",
    "@types/bcrypt": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cors": "^2.8.0",
    "typescript": "^5.3.0",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "supertest": "^6.3.0"
  }
}
