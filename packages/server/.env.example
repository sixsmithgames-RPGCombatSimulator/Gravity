# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://gravity:gravity_dev_password@localhost:5432/gravity_dev

# Redis Configuration
# Prefer REDIS_URL for managed staging/production services. rediss:// enables TLS.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Clerk identity verification (required for REST and Socket.IO session access)
CLERK_ISSUER=https://your-clerk-domain.example.com
# Optional when your Clerk token template includes an audience claim
CLERK_AUDIENCE=
# Comma-separated browser origins accepted in Clerk's azp claim. Defaults to CORS_ORIGIN.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Private lobby code hashing (minimum 16 characters; use a secret manager in production)
JOIN_CODE_PEPPER=replace-with-a-long-random-secret

# CORS Configuration
# Comma-separated browser origins allowed by REST and Socket.IO CORS.
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
# Shared Redis fixed-window protection for the /sessions HTTP edge. Route-specific
# per-identity limits are intentionally stricter and are defined in the server.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
