# Clerk's browser publishable key. Use a development instance for localhost.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# Leave blank when the API is reverse-proxied at the web origin.
VITE_API_URL=http://localhost:3000

# Reserved for the committed local Playwright harness. Never enable in a deployed environment.
VITE_E2E_AUTH_ENABLED=false
